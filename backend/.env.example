# Copy this file to .env and fill in your values
# This is a template ONLY - never commit your real .env file

# --- Database ---
# SQLite URL (default). Use any SQLAlchemy database URL.
DATABASE_URL=sqlite:///./interview_agent.db

# --- Secrets / Security ---
# Secret used to sign JWT / secure hashing. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated origins allowed for CORS (Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# --- AI Provider (OpenAI) ---
# Your OpenAI API key (required for AI question generation & evaluations)
OPENAI_API_KEY=sk-...
# Model to use for question generation / evaluation
OPENAI_MODEL=gpt-4o-mini
